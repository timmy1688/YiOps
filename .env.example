# MySQL is expected to be available already.
YIOPS_DATABASE_URL=mysql://root:change_me@127.0.0.1:3306/yiops?charset=utf8mb4
YIOPS_PORT=8100

# The API talks only to the bundled unified MCP server. Start both processes with
# ./service.sh start; datasource entries point at native read-only APIs.
YIOPS_MCP_URL=http://127.0.0.1:8110/mcp
YIOPS_MCP_INTERNAL_TOKEN=yiops-local-development-token
YIOPS_MCP_HOST=127.0.0.1
YIOPS_MCP_PORT=8110

# Use real observability data while keeping local evidence rules until a key is supplied.
YIOPS_DATASOURCE_MOCK_MODE=false
YIOPS_LLM_MOCK_MODE=true
YIOPS_AGENT_MAX_CONTEXT_TOKENS=24000
YIOPS_AGENT_MAX_REACT_ROUNDS=6
YIOPS_CHAT_MAX_TOOL_CALLS=8
YIOPS_CHAT_TOOL_RESULT_CHARS=8000
YIOPS_RAG_MAX_CHUNKS=6
YIOPS_RAG_CHUNK_CHARS=1800

# Authentication is optional in source development and enabled by default in Compose.
YIOPS_AUTH_ENABLED=false
YIOPS_ADMIN_USERNAME=admin
YIOPS_ADMIN_PASSWORD=
YIOPS_SESSION_TTL_HOURS=168
YIOPS_AUTH_COOKIE_SECURE=false

# To enable DeepSeek, set a key and switch LLM mock mode off.
YIOPS_MODEL_API_KEY=
YIOPS_MODEL_BASE_URL=https://api.deepseek.com
YIOPS_MODEL_NAME=deepseek-v4-pro
