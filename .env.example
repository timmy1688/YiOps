# MySQL is expected to be available already.
YIOPS_DATABASE_URL=mysql://root:change_me@127.0.0.1:3306/yiops?charset=utf8mb4

# Use real observability data while keeping local evidence rules until a key is supplied.
YIOPS_DATASOURCE_MOCK_MODE=false
YIOPS_LLM_MOCK_MODE=true

# Authentication is optional in source development and enabled by default in Compose.
YIOPS_AUTH_ENABLED=false
YIOPS_ADMIN_USERNAME=admin
YIOPS_ADMIN_PASSWORD=
YIOPS_SESSION_TTL_HOURS=168
YIOPS_AUTH_COOKIE_SECURE=false

# To enable DeepSeek, set a key and switch LLM mock mode off.
YIOPS_DEEPSEEK_API_KEY=
YIOPS_DEEPSEEK_MODEL=deepseek-v4-pro
