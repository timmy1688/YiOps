# Copy this file to .env.docker and replace all change_me values.
# Use long URL-safe passwords (letters, numbers, underscores, and hyphens),
# because MYSQL_PASSWORD is also embedded in a database connection URL.
MYSQL_DATABASE=yiops
MYSQL_USER=yiops
MYSQL_PASSWORD=change_me_app_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Keep the default bound to localhost. Put a reverse proxy with HTTPS in front
# of YiOps before changing this to 0.0.0.0.
YIOPS_BIND_ADDRESS=127.0.0.1
YIOPS_PORT=8100

YIOPS_DATASOURCE_MOCK_MODE=false
YIOPS_LLM_MOCK_MODE=true
