# ./deploy.sh generates .env.docker with random passwords automatically.
# Copy this file manually only when you need custom settings. Database passwords
# must be URL-safe because MYSQL_PASSWORD is embedded in a connection URL.
COMPOSE_PROJECT_NAME=yiops
MYSQL_IMAGE=mysql:8.4
YIOPS_IMAGE=yiops:local

MYSQL_DATABASE=yiops
MYSQL_USER=yiops
MYSQL_PASSWORD=change_me_app_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Listen on all interfaces for private-network evaluation. Use HTTPS and set
# YIOPS_AUTH_COOKIE_SECURE=true before exposing YiOps through a public hostname.
YIOPS_BIND_ADDRESS=0.0.0.0
YIOPS_PORT=8100
TZ=UTC

YIOPS_DATASOURCE_MOCK_MODE=false
YIOPS_LLM_MOCK_MODE=true
YIOPS_ANALYSIS_CONCURRENCY=2
YIOPS_ANALYSIS_TIMEOUT_SECONDS=300
YIOPS_DATASOURCE_TIMEOUT_SECONDS=15

YIOPS_AUTH_ENABLED=true
YIOPS_ADMIN_USERNAME=admin
YIOPS_ADMIN_PASSWORD=change_me_admin_password
YIOPS_SESSION_TTL_HOURS=168
YIOPS_AUTH_COOKIE_SECURE=false
