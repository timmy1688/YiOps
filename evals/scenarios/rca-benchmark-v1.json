    "id": "crashloop-config-001", "category": "configuration", "title": "支付服务配置缺失导致 CrashLoop",
    "incident": {"service": "payment-api", "alert": "KubePodCrashLooping"},
    "observations": [
      {"id": "c1-log", "source": "loki", "summary": "startup failed: missing DB_URL environment variable from ConfigMap"},
      {"id": "c1-k8s", "source": "kubernetes", "summary": "pod CrashLoopBackOff after ConfigMap checkout; missing DB_URL key"},
      {"id": "c1-cpu", "source": "prometheus", "summary": "CPU remained below 20 percent"}
    ],
    "expected": {"cause_keywords": ["configmap", "环境变量"], "relevant_evidence_ids": ["c1-log", "c1-k8s"], "required_sources": ["loki", "kubernetes"]}
  },
